# Server Configuration
PORT=3000

# MongoDB Connection String (Replica Set required for MongoDB ACID Transactions)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bank-transaction-system?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_replace_in_production

# Email Service Configuration (Google OAuth2 via Nodemailer)
EMAIL_USER=your-email@gmail.com
CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-google-oauth-client-secret
REFRESH_TOKEN=your-google-oauth-refresh-token
